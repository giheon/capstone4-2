# Copy to .env. Keep credentials on the server; never put keys in frontend VITE_* variables.
OPENAI_API_KEY=
PRIVFRAME_REDIS_URL=redis://127.0.0.1:6379/0
PRIVFRAME_FRONTEND_ORIGIN=http://localhost:5173
# Optional absolute paths. Defaults are ./data and ./models/face_detection_yunet_2023mar.onnx
# PRIVFRAME_DATA_DIR=/absolute/path/data
# PRIVFRAME_MODEL_PATH=/absolute/path/models/face_detection_yunet_2023mar.onnx
